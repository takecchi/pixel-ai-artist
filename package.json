{
  "name": "pixel-ai-artist",
  "version": "0.1.0",
  "description": "Pixel art from your coding agent, no editor required. MCP server + cross-agent skills for Claude Code, omp, Codex, Gemini CLI and Cursor. A port of with-pebbly/aseprite-ai-artist.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "pixel-ai-artist": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills",
    "rules",
    "agents",
    "hooks",
    "omp",
    "opencode",
    "knowledge",
    "templates",
    "examples",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takecchi/pixel-ai-artist.git"
  },
  "homepage": "https://github.com/takecchi/pixel-ai-artist#readme",
  "bugs": "https://github.com/takecchi/pixel-ai-artist/issues",
  "keywords": [
    "pixel-art",
    "mcp",
    "model-context-protocol",
    "sprites",
    "animation",
    "claude-code",
    "omp",
    "oh-my-pi",
    "codex",
    "gemini-cli",
    "cursor",
    "opencode"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "omp": {
    "extensions": [
      "./omp/pixel-ai-artist.mjs"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
